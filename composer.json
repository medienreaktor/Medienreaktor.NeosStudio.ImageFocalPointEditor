{
  "name": "medienreaktor/neos-studio-image-focal-point-editor",
  "type": "neos-plugin",
  "description": "The image focal point editor for Neos Studio: click into the image to set the point that stays visible when it is cropped. Drop-in replacement for the classic-UI JvMTECH.Neos.ImageFocalPointEditor - same editor id, same options, same stored value.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "neos",
    "neoscms",
    "flow",
    "editor",
    "image",
    "focal-point",
    "neos-studio"
  ],
  "require": {
    "php": "^8.2",
    "neos/neos": "^9.1",
    "medienreaktor/neos-studio": "^1.19.1 || ^2.0",
    "jvmtech/neos-imagefocalpointeditor": "^0.1.1"
  },
  "require-dev": {
    "neos/contentgraph-doctrinedbaladapter": "^9.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "extra": {
    "neos": {
      "package-key": "Medienreaktor.NeosStudio.ImageFocalPointEditor"
    },
    "branch-alias": {
      "dev-main": "1.1.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "neos/composer-plugin": true
    }
  },
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "lint:composer": "@composer validate --strict --no-check-lock",
    "lint:phpstan": "@php vendor/bin/phpstan analyse",
    "lint:phpcs": "./vendor/bin/phpcs --colors",
    "lint:phpcs:fix": "./vendor/bin/phpcbf --colors",
    "lint": [
      "@lint:composer",
      "@lint:phpcs",
      "@lint:phpstan"
    ]
  }
}
